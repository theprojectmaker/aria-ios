{
  "expo": {
    "name": "Aria",
    "slug": "aria",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aria",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0E0B1E",
    "ios": {
      "bundleIdentifier": "com.solyapps.aria",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.kernel.increased-memory-limit": true
      }
    },
    "android": {
      "package": "com.solyapps.aria",
      "adaptiveIcon": {
        "backgroundColor": "#0E0B1E",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "permissions": []
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0B1E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 128,
          "dark": {
            "backgroundColor": "#0E0B1E",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 128
          }
        }
      ],
      "expo-status-bar",
      "expo-system-ui",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "@kesha-antonov/react-native-background-downloader",
      "react-native-blob-util",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aria lets you pick a photo to ask the on-device AI about it. Your photos never leave your device.",
          "cameraPermission": "Aria lets you take a photo to ask the on-device AI about it. Your photos never leave your device."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "solomonsasson",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "97e7ddaf-b7ee-42ae-a873-e2ad7450733c"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/97e7ddaf-b7ee-42ae-a873-e2ad7450733c"
    }
  }
}
